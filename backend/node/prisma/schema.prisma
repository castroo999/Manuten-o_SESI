generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       String     @id @default(uuid())
  username String     @map("user")
  email    String     @unique
  password String
  role     String     @default("user")
  chamados Chamado[]

  @@map("user")
}

model Chamado {
  id         String   @id @default(uuid())
  titulo     String
  descricao  String
  local      String   @default("")
  prioridade String   @default("media")
  userId     String?  @map("user_id")
  status     String   @default("aberto")
  foto       String   @default("")
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamp(3)
  usuario    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([criadoEm])
  @@map("chamados")
}

model AppMigration {
  id        String   @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("app_migrations")
}
